#!/bin/bash

dotfiles="$HOME/.config/dotfiles"
playlist="$HOME/documents/wallpapers/animated/playlist.m3u"
socket="/tmp/mpv-socket"

total=$(grep -c '\.mp4' "$playlist" 2>/dev/null)
[[ $total -gt 0 ]] || { echo "No wallpapers in playlist"; exit 1; }

response=$(echo '{"command": ["get_property", "playlist-pos"]}' | socat - "$socket" 2>/dev/null)
current=$(echo "$response" | grep -o '"data":[0-9]*' | grep -o '[0-9]*$')
[[ "$current" =~ ^[0-9]+$ ]] || current=0

next=$(( (current + 1) % total ))

echo "{\"command\": [\"set_property\", \"playlist-pos\", $next]}" | socat - "$socket"

n=$(( next + 1 ))
if [[ -f "$dotfiles/alacritty/themes-mapping" ]]; then
    theme=$(sed -n "${n}p" "$dotfiles/alacritty/themes-mapping" | tr '|' '\n' | shuf -n 1)
    [[ -z $theme ]] || alacritty-themes "$theme"
fi
